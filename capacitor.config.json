{
  "appId": "com.boraler.app",
  "appName": "Boraler",
  "webDir": "www",
  "backgroundColor": "#080808",
  "server": {
    "allowNavigation": [
      "drive.google.com",
      "docs.google.com",
      "*.googleusercontent.com",
      "github.com",
      "*.githubusercontent.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  },
  "android": {
    "backgroundColor": "#080808"
  },
  "ios": {
    "backgroundColor": "#080808",
    "contentInset": "always"
  }
}